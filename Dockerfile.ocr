# Subtitle Robot — 태그 ocr: 이미지 자막(PGS·VobSub) OCR 용 Tesseract (WI-5.004c)
# 이 파일은 subtitle-robot:latest(기본 Dockerfile) 위에 Tesseract 층만 더한다. latest 를 먼저 빌드한다 (scripts/build-images.sh 가 순서를 지킨다).
#   OCR 은 CPU 를 많이 쓰므로 성능 좋은 PC 에서 쓴다. 켜기: [media] ocr = true (웹 Settings 의 미디어 탭)
#   언어 데이터: --build-arg OCR_LANGS=eng,jpn,kor,chi_sim,fra (쉼표로 구분, Alpine 패키지 tesseract-ocr-data-<이름>)
ARG BASE_IMAGE=subtitle-robot:latest
FROM ${BASE_IMAGE}
ARG OCR_LANGS=eng,jpn,kor
RUN apk add --no-cache tesseract-ocr $(echo "${OCR_LANGS}" | tr ',' '\n' | sed 's/^/tesseract-ocr-data-/') \
    && tesseract --list-langs
